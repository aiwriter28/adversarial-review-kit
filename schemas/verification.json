{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "dispositions", "check_dispositions", "new_findings", "checks"],
  "properties": {
    "summary": {"type": "string"},
    "dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "status": {"type": "string", "enum": ["resolved", "deferred", "unresolved"]},
          "evidence": {"type": "string"}
        }
      }
    },
    "check_dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence", "replacement_command", "equivalent"],
        "properties": {
          "id": {"type": "string"},
          "status": {"type": "string", "enum": ["resolved", "unresolved"]},
          "evidence": {"type": "string"},
          "replacement_command": {"type": "string"},
          "equivalent": {"type": "boolean"}
        }
      }
    },
    "new_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "axis", "location", "problem", "evidence", "suggested_check"],
        "properties": {
          "id": {"type": "string"},
          "severity": {"type": "string", "enum": ["critical", "major", "minor"]},
          "axis": {"type": "string", "enum": ["spec", "standards", "both"]},
          "location": {"type": "string"},
          "problem": {"type": "string"},
          "evidence": {"type": "string"},
          "suggested_check": {"type": "string"}
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "outcome", "evidence", "purpose"],
        "properties": {
          "command": {"type": "string"},
          "outcome": {"type": "string", "enum": ["pass", "fail", "uncertain"]},
          "evidence": {"type": "string"},
          "purpose": {"type": "string", "enum": ["acceptance", "exploration"]}
        }
      }
    }
  }
}
